# The library needs no environment variables. These only affect the docs site build.

# Optional. Your GoatCounter site code (the "code" in https://<code>.goatcounter.com).
# When set, the docs site counts page views without cookies or personal data.
# In GitHub Actions, add it as a repository variable named GOATCOUNTER_CODE.
GOATCOUNTER_CODE=

# Optional. Base path the docs are served from. Defaults to /bharat-kit/ for GitHub Pages.
# Set to / when serving from a custom domain.
DOCS_BASE=/bharat-kit/
